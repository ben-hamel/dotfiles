{
  "autoMemoryEnabled": false,
  "effortLevel": "high",
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/ben/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bun -e ':*)",
      "WebFetch(domain:ai-sdk.dev)",
      "WebFetch(domain:reference.langchain.com)"
    ]
  },
  "preferredNotifChannel": "ghostty",
  "statusLine": {
    "command": "bash ~/.claude/statusline-powerline.sh",
    "type": "command"
  },
  "syntaxHighlightingDisabled": false,
  "theme": "auto"
}