theme = Catppuccin Mocha
# theme = Aura
# theme = GitHub Dark
# theme = Github Dark Default

background-opacity = 0.88
# background-blur = true
background-blur-radius = 25

window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

unfocused-split-opacity = 0.55
split-divider-color = #524f67

cursor-style = block
cursor-style-blink = true

copy-on-select = clipboard

# font-family = Hack Nerd Font Mono
font-family = JetBrainsMonoNL Nerd Font
# font-family = JetBrainsMonoNL Nerd Font Mono
# font-family = Menlo
# font-family = Monaco

font-size = 14


# This for using alt + option for Zellij. If not using Zellij then probably not needed.
# https://zellij.dev/documentation/faq.html#i-am-a-macos-user-how-can-i-use-the-alt-key
macos-option-as-alt = true 
# keybind = alt+left=unbind
# keybind = alt+right=unbind

desktop-notifications = true